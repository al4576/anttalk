rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId}/messages/{messageId} {
      // The room ID acts like the shared secret.
      // For a private deployment, add Firebase Authentication and
      // tighten these rules to your authenticated users.
      allow read, create, delete: if
        roomId.size() >= 4 && roomId.size() <= 80;
    }
  }
}